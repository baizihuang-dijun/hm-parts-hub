# Public site origin (no trailing slash). Used for canonical URLs, OG tags, sitemap.
# If unset, the build falls back to the sandbox deployment domain
# (COZE_PROJECT_DOMAIN_DEFAULT); never commit a placeholder domain.
# Example: NEXT_PUBLIC_SITE_URL=https://parts.your-company.com
NEXT_PUBLIC_SITE_URL=

# Web3Forms access key for the RFQ form. Get one at https://web3forms.com
# If unset, the RFQ page shows a "being configured" placeholder instead of the form.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Mailbox shown as the email fallback on the RFQ page / privacy page.
NEXT_PUBLIC_RFQ_EMAIL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX).
# GA4 is only injected after the visitor explicitly accepts analytics consent.
NEXT_PUBLIC_GA4_ID=
